# 依赖与构建产物
node_modules/
out/
dist/
release/

# 上游参考克隆（只读对照，不入库）
../kumone-upstream/

# mpv 二进制与下载缓存：体积大且可由 scripts/fetch-mpv.ps1 复原
vendor/
resources/mpv/

# 本地数据
*.log
.DS_Store
Thumbs.db
.tmp-*
# 真机脚本截的图（只在本地看，不进仓库）
shots-*/

# 一起听中继的运行时数据与密钥：余额/订单状态、支付宝应用私钥，绝不入库
server/data/

# 官网上放的安装包镜像（体积 200MB+，只存在服务器上，不进仓库）
website/xz/
website/downloads/
# 宝塔在站点目录里生成的环境文件（含服务器路径，属服务器侧配置）
website/.user.ini
