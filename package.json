{
  "name": "youyou-music",
  "version": "0.4.3",
  "description": "悠悠音乐 — NetEase Cloud Music client for Windows (Electron + mpv)",
  "main": "out/main/index.js",
  "author": "悠悠音乐",
  "license": "LGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "dist": "electron-vite build && node scripts/package.mjs",
    "dist:installer": "electron-vite build && electron-builder --win nsis --publish never",
    "dist:portable": "electron-vite build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "7zip-bin": "^5.2.0",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
